-- Shotgun Bypass Variables
local projConnections = {}
local projAttached = setmetatable({}, { __mode = "k" })
local projHeadHistory = {}

local PROJECTILE_SPEED = 150
local HISTORY_SIZE = 12
local MAX_LEAD_TIME = 0.45
local GRAVITY = workspace.Gravity
local HITBOX_OFFSET = Vector3.new(0, 0.15, 0)
local SNAP_DIST_THRESHOLD = 0.08
local LERP_SPEED = 0.72
local TARGET_FOLDERS = { ["Shotgun"] = true }
local ORIENTATION_OFFSET = CFrame.new()

local estimatedPing = 0
task.spawn(function()
	while true do
		local s = tick()
		RunService.Heartbeat:Wait()
		estimatedPing = math.clamp(tick() - s, 0, 0.25)
	end
end)

local function UpdateHeadHistory(head)
	if not head or not head.Parent then return end
	local id = tostring(head)
	if not projHeadHistory[id] then
		projHeadHistory[id] = { vel = Vector3.zero, acc = Vector3.zero }
	end
	local hist = projHeadHistory[id]
	local now = tick()

	table.insert(hist, { pos = head.Position, t = now })
	if #hist > HISTORY_SIZE then
		table.remove(hist, 1)
	end

	if #hist >= 2 then
		local a = hist[#hist - 1]
		local b = hist[#hist]
		local dt = b.t - a.t
		if dt > 0 then
			local newVel = (b.pos - a.pos) / dt
			hist.vel = hist.vel:Lerp(newVel, 0.6)
		end
	end

	if #hist >= 3 then
		local a = hist[#hist - 2]
		local b = hist[#hist - 1]
		local c = hist[#hist]
		local dt1 = b.t - a.t
		local dt2 = c.t - b.t
		if dt1 > 0 and dt2 > 0 then
			local v1 = (b.pos - a.pos) / dt1
			local v2 = (c.pos - b.pos) / dt2
			local accRaw = (v2 - v1) / ((dt1 + dt2) / 2)
			hist.acc = hist.acc:Lerp(accRaw, 0.35)
		end
	end
end

local function PredictPosition(head, fromPos)
	if not head or not head.Parent then return nil end
	local id = tostring(head)
	local hist = projHeadHistory[id]
	if not hist or #hist < 2 then
		return head.Position + HITBOX_OFFSET
	end

	local vel = hist.vel
	local acc = hist.acc

	local dist = (fromPos - head.Position).Magnitude
	local travelTime = dist / PROJECTILE_SPEED
	local ping = estimatedPing
	local leadTime = math.clamp(travelTime + ping, 0, MAX_LEAD_TIME)

	local predicted = head.Position
		+ vel * leadTime
		+ acc * (0.5 * leadTime * leadTime)
		+ HITBOX_OFFSET

	local gravityDrop = Vector3.new(0, -GRAVITY * 0.5 * travelTime * travelTime, 0)
	predicted = predicted - gravityDrop

	return predicted
end

local function GetBestTarget(fromPos)
	local myChar = LocalPlayer.Character
	local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myHRP then return nil end

	local bestHead, bestScore = nil, math.huge

	for _, plr in pairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local char = plr.Character
			local head = char and char:FindFirstChild("Head")
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")

			if head and hrp and hum and hum.Health > 0 then
				local dist = (fromPos - head.Position).Magnitude
				local id = tostring(head)
				local hist = projHeadHistory[id]
				local velMag = hist and hist.vel.Magnitude or 0

				local score = dist + velMag * 0.4
				if score < bestScore then
					bestScore = score
					bestHead = head
				end
			end
		end
	end

	return bestHead
end

local function AttachPartToClosestHead(part)
	if not part or not part:IsA("BasePart") then return end
	if projAttached[part] then return end
	projAttached[part] = true

	part.CanCollide = false
	part.Massless = true

	task.spawn(function()
		local smoothPos = part.Position

		while part and part.Parent and Toggles.ShotgunBypassToggle and Toggles.ShotgunBypassToggle.Value do
			local head = GetBestTarget(part.Position)

			if head and head.Parent then
				UpdateHeadHistory(head)
				local predicted = PredictPosition(head, part.Position)

				if predicted then
					local dist = (smoothPos - predicted).Magnitude

					if dist < SNAP_DIST_THRESHOLD then
						smoothPos = predicted
					else
						smoothPos = smoothPos:Lerp(predicted, LERP_SPEED)
					end

					part.AssemblyAngularVelocity = Vector3.zero
					part.AssemblyLinearVelocity = Vector3.zero
					part.CFrame = CFrame.new(smoothPos) * ORIENTATION_OFFSET
				end
			end

			RunService.Heartbeat:Wait()
		end
	end)
end

local function HandleInstance(inst)
	if not (Toggles.ShotgunBypassToggle and Toggles.ShotgunBypassToggle.Value) then return end
	if not inst or not inst.Parent then return end

	if inst:IsA("BasePart") then
		AttachPartToClosestHead(inst)
	elseif inst:IsA("Model") or inst:IsA("Folder") then
		for _, d in ipairs(inst:GetDescendants()) do
			if d:IsA("BasePart") then
				AttachPartToClosestHead(d)
			end
		end
	end
end

local function HookFolder(folder)
	for _, d in ipairs(folder:GetDescendants()) do
		HandleInstance(d)
	end
	local conn = folder.DescendantAdded:Connect(HandleInstance)
	table.insert(projConnections, conn)
end

local function EnableShotgunBypass()
	table.clear(projConnections)
	table.clear(projAttached)
	table.clear(projHeadHistory)

	local trackConn = RunService.Heartbeat:Connect(function()
		if Toggles.ShotgunBypassToggle and Toggles.ShotgunBypassToggle.Value then
			for _, plr in pairs(Players:GetPlayers()) do
				if plr ~= LocalPlayer then
					local char = plr.Character
					local head = char and char:FindFirstChild("Head")
					if head then
						UpdateHeadHistory(head)
					end
				end
			end
		end
	end)
	table.insert(projConnections, trackConn)

	for _, child in ipairs(workspace:GetChildren()) do
		if TARGET_FOLDERS[child.Name] then
			HookFolder(child)
		end
	end

	local conn = workspace.ChildAdded:Connect(function(child)
		if TARGET_FOLDERS[child.Name] then
			HookFolder(child)
		end
	end)
	table.insert(projConnections, conn)
end

local function DisableShotgunBypass()
	for _, conn in ipairs(projConnections) do
		pcall(function() conn:Disconnect() end)
	end
	table.clear(projConnections)
	table.clear(projAttached)
	table.clear(projHeadHistory)
end

Toggles.ShotgunBypassToggle:OnChanged(function(Value)
	if Value then
		EnableShotgunBypass()
	else
		DisableShotgunBypass()
	end
end)

local function isEnemy(player)
	if player == LocalPlayer then return false end
	if SpectateController then
		pcall(function()
			local duel = SpectateController.CurrentDuelSubject
			local localDueler = duel and duel:GetDueler(LocalPlayer)
			local localTeam = localDueler and localDueler:Get("TeamID") or nil
			
			if localTeam and duel and duel.Duelers then
				for _, dueler in ipairs(duel.Duelers) do
					if dueler.Player == player then
						local team = dueler:Get("TeamID")
						return team ~= localTeam
					end
				end
			end
		end)
	end
	
	local pTeam = player:GetAttribute("TeamID")
	local lTeam = LocalPlayer:GetAttribute("TeamID")
	if pTeam and lTeam then
		return pTeam ~= lTeam
	end
	return true
end

local function getEvasionOffset(maxDist)
	local mode = Options.VoidModeDropdown and Options.VoidModeDropdown.Value or "Random"
	
	if mode == "Random" then
		local u = math.random()
		local v = math.random()
		local theta = u * 2.0 * math.pi
		local phi = math.acos(2.0 * v - 1.0)
		local r = maxDist * (math.random() ^ (1/3))
		return r * math.sin(phi) * math.cos(theta), r * math.sin(phi) * math.sin(theta), r * math.cos(phi)
	elseif mode == "Orbit" then
		local u = math.random()
		local v = math.random()
		local theta = u * 2.0 * math.pi
		local phi = math.acos(2.0 * v - 1.0)
		return maxDist * math.sin(phi) * math.cos(theta), maxDist * math.sin(phi) * math.sin(theta), maxDist * math.cos(phi)
	elseif mode == "Box" then
		return (math.random() * 2 - 1) * maxDist, (math.random() * 2 - 1) * maxDist, (math.random() * 2 - 1) * maxDist
	elseif mode == "Sky" then
		return (math.random() * 2 - 1) * maxDist, math.random(maxDist * 0.1, maxDist), (math.random() * 2 - 1) * maxDist
	elseif mode == "Glitch" then
		local signX = math.random(0, 1) == 1 and 1 or -1
		local signY = math.random(0, 1) == 1 and 1 or -1
		local signZ = math.random(0, 1) == 1 and 1 or -1
		return math.random(maxDist * 0.8, maxDist) * signX, math.random(maxDist * 0.8, maxDist) * signY, math.random(maxDist * 0.8, maxDist) * signZ
	end
	
	return (math.random() * 2 - 1) * maxDist, (math.random() * 2 - 1) * maxDist, (math.random() * 2 - 1) * maxDist
end

local function getNearestPlayer()
	local nearest = nil
	local shortestDist = math.huge
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
	local myPos = char.HumanoidRootPart.Position

	local isTeamCheckActive = Toggles.TeamCheckToggle and Toggles.TeamCheckToggle.Value

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			if isTeamCheckActive and not isEnemy(player) then
				continue
			end

			local enemyHrp = player.Character.HumanoidRootPart
			local dist = (myPos - enemyHrp.Position).Magnitude
			if dist < shortestDist then
				shortestDist = dist
				nearest = player
			end
		end
	end
	return nearest
end

