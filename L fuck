		if not wasKickActive then
			originalPlayerPositions = {}
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
					originalPlayerPositions[player] = player.Character.HumanoidRootPart.CFrame
				end
			end
			wasKickActive = true
		end

		pcall(function()
			local targetVoidPos = CFrame.new(500000, 500000, 500000)
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
					player.Character.HumanoidRootPart.CFrame = targetVoidPos
				end
			end
		end)
	else
		if wasKickActive then
			pcall(function()
				for player, originalCFrame in pairs(originalPlayerPositions) do
					if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
						player.Character.HumanoidRootPart.CFrame = originalCFrame
					end
				end
			end)
			originalPlayerPositions = {}
			wasKickActive = false
		end
	end

	if Toggles.UndergroundToggle and Toggles.UndergroundToggle.Value then
		pcall(function()
			local character = LocalPlayer.Character
			if not (character and character.PrimaryPart) then
				lockedY = nil; lastPos = nil; originalY = nil
				return
			end
			
			local root = character:FindFirstChild("HumanoidRootPart")
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			
			if root and humanoid and humanoid.Health > 0 then
				humanoid.Health = humanoid.MaxHealth
				for _, part in ipairs(character:GetChildren()) do
					if part:IsA("BasePart") then
						part.CanTouch = false
						part.AssemblyLinearVelocity = Vector3.zero
						part.AssemblyAngularVelocity = Vector3.zero
					end
				end

				local currentPos = root.Position
				local depthOffset = -(Options.UndergroundDepthSlider and Options.UndergroundDepthSlider.Value or 6)
				
				if not lockedY then
					if not originalY then originalY = currentPos.Y end
					lockedY = currentPos.Y + depthOffset
				else
					lockedY = (originalY or currentPos.Y) + depthOffset
				end
				
				local moveDir = humanoid.MoveDirection
				if moveDir.Magnitude > 0 then
					local baseSpeed = humanoid.WalkSpeed
					local modifiedSpeed = baseSpeed * SPEED_MULTIPLIER
					lastPos = currentPos + (moveDir * modifiedSpeed * deltaTime)
				else
					if not lastPos then lastPos = currentPos end
				end
				
				local rotationComponent = root.CFrame - currentPos
				root.CFrame = CFrame.new(lastPos.X, lockedY, lastPos.Z) * rotationComponent
			else
				lockedY = nil; lastPos = nil; originalY = nil
			end
		end)
	else
		if lockedY then
			lockedY = nil; lastPos = nil; originalY = nil
			pcall(function()
				local character = LocalPlayer.Character
				if character then
					for _, part in ipairs(character:GetChildren()) do
						if part:IsA("BasePart") then part.CanTouch = true end
					end
				end
			end)
		end
	end

	if Toggles.ModDetectorToggle and Toggles.ModDetectorToggle.Value then
		pcall(function()
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and not flaggedMods[player.UserId] then
					local isVerifiedStaff = false
					if player.UserId == game.CreatorId then isVerifiedStaff = true end
					
					pcall(function()
						if game.CreatorType == Enum.CreatorType.Group and player:GetRankInGroup(game.CreatorId) >= 200 then
							isVerifiedStaff = true
						end
					end)

					pcall(function()
						if (player:GetAttribute("AdminLevel") and player:GetAttribute("AdminLevel") > 0) or player:GetAttribute("IsAdmin") == true then
							isVerifiedStaff = true
						end
					end)

					if isVerifiedStaff then
						flaggedMods[player.UserId] = true
						Library:Notify("Mod detected: " .. player.Name, 10)
						if Toggles.ModDetectorInstaLeave and Toggles.ModDetectorInstaLeave.Value then
							TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
						end
					end
				end
			end
		end)
	end
end)

task.spawn(function()
	while true do
		if Toggles.VoidSpamToggle and Toggles.VoidSpamToggle.Value then
			pcall(function()
				local character = LocalPlayer.Character
				if character and character:FindFirstChild("HumanoidRootPart") then
					local hrp = character.HumanoidRootPart
					local maxDist = Options.VoidDistanceSlider and Options.VoidDistanceSlider.Value or 500000000000
					local layers = Options.UnhittableLayersSlider and Options.UnhittableLayersSlider.Value or 10
					local isTPEverywhereActive = Toggles.TPEverywhereToggle and Toggles.TPEverywhereToggle.Value
					
					local currentDist = isTPEverywhereActive and (Options.TPEverywhereSpeedSlider and Options.TPEverywhereSpeedSlider.Value or 700000000000) or maxDist
					
					for i = 1, layers do
						local rx, ry, rz = getEvasionOffset(currentDist)
						local desyncVelocity = Vector3.new(
							math.random(-999999, 999999),
							math.random(-999999, 999999),
							math.random(-999999, 999999)
						)
						hrp.AssemblyLinearVelocity = desyncVelocity
						hrp.AssemblyAngularVelocity = desyncVelocity
						hrp.CFrame = CFrame.new(rx, ry, rz)
					end
				end
			end)
		end
		
		local isTPEverywhereActive = Toggles.TPEverywhereToggle and Toggles.TPEverywhereToggle.Value
		local speed = (isTPEverywhereActive and Options.TPEverywhereCooldownSlider) and Options.TPEverywhereCooldownSlider.Value or (Options.VoidSpeedSlider and Options.VoidSpeedSlider.Value or 0.00000001)
		task.wait(speed)
	end
end)

